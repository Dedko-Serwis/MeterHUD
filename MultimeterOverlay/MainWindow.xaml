<Window x:Class="MultimeterOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MultimeterOverlay.ViewModels"
        Title="Multimeter Overlay"
        Width="560"
        Height="300"
        MinWidth="400"
        MinHeight="230"
        Background="#181818"
        Foreground="White"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter
        x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="DeviceNameText"
                   Text="{Binding DeviceName}"
                   FontSize="18"
                   Foreground="#AAAAAA"/>

        <Grid Grid.Row="1"
      VerticalAlignment="Center"
      HorizontalAlignment="Center">

            <!-- Zwykły pojedynczy pomiar -->
            <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center">

                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAcDcMode}"
                                 Value="True">
                                <Setter Property="Visibility"
                                Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock x:Name="ValueText"
                   Text="{Binding DisplayValue}"
                   FontSize="76"
                   FontWeight="SemiBold"
                   FontFamily="Consolas"
                   VerticalAlignment="Center"/>

                <TextBlock x:Name="UnitText"
                   Text="{Binding Unit}"
                   FontSize="24"
                   Margin="12,20,0,0"
                   VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Dwa pomiary AC+DC -->
            <StackPanel HorizontalAlignment="Center">

                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAcDcMode}"
                                 Value="True">
                                <Setter Property="Visibility"
                                Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
                    <TextBlock Text="~"
                       Foreground="#F4D35E"
                       FontSize="32"
                       Width="45"/>

                    <TextBlock Text="{Binding AcDisplayValue}"
                       FontFamily="Consolas"
                       FontSize="42"
                       Foreground="White"/>

                    <TextBlock Text="{Binding AcDcUnit}"
                       FontSize="22"
                       Margin="12,12,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
                    <TextBlock Text="⎓"
                       Foreground="#62D989"
                       FontSize="32"
                       Width="45"/>

                    <TextBlock Text="{Binding DcDisplayValue}"
                       FontFamily="Consolas"
                       FontSize="42"
                       Foreground="White"/>

                    <TextBlock Text="{Binding AcDcUnit}"
                       FontSize="22"
                       Margin="12,12,0,0"/>
                </StackPanel>

            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <TextBlock x:Name="FunctionText"
                       Text="{Binding Function}" 
                       FontSize="17"
                       Margin="0,0,20,0"/>

            <TextBlock x:Name="RangeText"
                       Text="{Binding Range}"
                       Foreground="#AAAAAA"
                       FontSize="15"
                       Margin="0,0,20,0"/>

            <TextBlock x:Name="HoldText"
                       Text="HOLD"
                       Foreground="Orange"
                       FontWeight="Bold"
                       Visibility="{Binding IsHold, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <StatusBar Grid.Row="3"
           Margin="0,12,0,0"
           Background="#252525"
           Foreground="#DDDDDD">

            <StatusBarItem>
                <TextBlock Text="F12"
                   Foreground="#888888"/>
            </StatusBarItem>
            
            <StatusBarItem>
                <TextBlock x:Name="RecordingIndicator" Text="{Binding RecordingStatus}" FontWeight="Bold" Foreground="#999999" Width="50"/>
            </StatusBarItem>
            
            <Separator/>
            
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Ramki: "
                       Foreground="#AAAAAA" />
                    <TextBlock Text="{Binding RecordedFrames}" Width="50"/>
                </StackPanel>
            </StatusBarItem>

            <Separator/>

            
            <StatusBarItem>
                <TextBlock Text="{Binding Status}"
                   Foreground="#55D980"/>
            </StatusBarItem>            

        </StatusBar>
    </Grid>
</Window>
