<Window x:Class="MultimeterOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MultimeterOverlay.ViewModels"
        Title="Multimeter Overlay"
        Width="560"
        Height="300"
        MinWidth="400"
        MinHeight="230"
        Background="#181818"
        Foreground="White"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter
        x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Menu główne -->
        <Menu DockPanel.Dock="Top"
      Background="#252525"
      Foreground="White">

            <Menu.Resources>
                <Style TargetType="{x:Type MenuItem}">
                    <Setter Property="Foreground" Value="Black"/>
                </Style>
            </Menu.Resources>

            <MenuItem Header="{Binding Source={StaticResource Loc}, Path=[MenuOptions]}"
              Foreground="White">

                <MenuItem x:Name="ShowOverlayMenuItem"
                  Header="{Binding Source={StaticResource Loc}, Path=[MenuShowOverlay]}"
                  IsCheckable="True"
                  IsChecked="True"
                  Click="ShowOverlayMenuItem_Click"/>

                <Separator/>

                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=[MenuOpenCsvFolder]}"
                  Click="OpenCsvFolder_Click"/>

                <Separator/>

                <MenuItem x:Name="SimulationMenuItem"
                  Header="{Binding Source={StaticResource Loc}, Path=[MenuSimulation]}"
                  IsCheckable="True"
                  IsChecked="False"
                  Click="SimulationMenuItem_Click"/>

                <Separator/>

                <MenuItem x:Name="DisplayTestMenuItem"
                  Header="{Binding Source={StaticResource Loc}, Path=[MenuDisplayTest]}"
                  IsCheckable="True"
                  IsChecked="False"
                  Click="DisplayTestMenuItem_Click"/>

                <Separator/>

                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=[MenuResetSettings]}"
                  Click="ResetSettings_Click"/>

                <Separator/>

                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=[MenuSettings]}"
                  Click="SettingsMenuItem_Click"/>

            </MenuItem>
        </Menu>


        <!-- StatusBar przeniesiemy tutaj -->
        <StatusBar DockPanel.Dock="Bottom"  Background="#252525" Foreground="#DDDDDD">

            <StatusBarItem>
                <TextBlock Text="F12"
           Foreground="#888888"/>
            </StatusBarItem>

            <StatusBarItem>
                <TextBlock x:Name="RecordingIndicator" Text="{Binding RecordingStatus}" FontWeight="Bold" Foreground="#999999" Width="50"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[StatusFrames]}" Margin="0,0,5,0" Foreground="#AAAAAA"/>
                    <TextBlock Text="{Binding RecordedFrames}" Width="50"/>
                </StackPanel>
            </StatusBarItem>

            <Separator/>



            <StatusBarItem>
                <TextBlock Text="{Binding Status}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <!-- Domyślnie szary -->
                            <Setter Property="Foreground"                Value="#999999"/>

                            <Style.Triggers>
                                <!-- Poprawna komunikacja -->
                                <DataTrigger Binding="{Binding ConnectionState}"             Value="Connected">
                                    <Setter Property="Foreground"                        Value="#39C875"/>
                                </DataTrigger>

                                <!-- Chwilowy brak odpowiedzi -->
                                <DataTrigger Binding="{Binding ConnectionState}"             Value="Waiting">
                                    <Setter Property="Foreground"                        Value="#F4D35E"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>


        </StatusBar>

        <!-- Obszar pomiarów -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <TextBlock x:Name="DeviceNameText"
                   Text="{Binding DeviceName}"
                   FontSize="18"
                   Foreground="#AAAAAA"/>

            <Grid Grid.Row="1"
      VerticalAlignment="Center"
      HorizontalAlignment="Center">


                <!-- Zwykły pojedynczy pomiar -->
                <Grid HorizontalAlignment="Center"
      VerticalAlignment="Center">

                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAcDcMode}"
                             Value="True">
                                    <Setter Property="Visibility"
                            Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <!-- Wartość pomiaru -->
                        <ColumnDefinition Width="340"/>

                        <!-- Jednostka -->
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <!-- Wartość wyrównana do prawej -->
                    <TextBlock x:Name="ValueText"
               Grid.Column="0"
               Text="{Binding DisplayValue}"
               FontSize="76"
               FontWeight="SemiBold"
               FontFamily="Consolas"
               Foreground="White"
               TextAlignment="Right"
               VerticalAlignment="Center"
               TextWrapping="NoWrap"/>

                    <!-- Jednostka w stałej kolumnie -->
                    <TextBlock x:Name="UnitText"
               Grid.Column="1"
               Text="{Binding Unit}"
               FontSize="24"
               Margin="12,20,0,0"
               VerticalAlignment="Center"
               TextWrapping="NoWrap"/>
                </Grid>


                <!-- Dwa pomiary AC+DC -->
                <StackPanel HorizontalAlignment="Center">

                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAcDcMode}"
                                 Value="True">
                                    <Setter Property="Visibility"
                                Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>



                    <!-- AC -->
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
               Text="{Binding AcDisplayValue}"
               FontFamily="Consolas"
               FontSize="42"
               Foreground="White"
               TextAlignment="Right"/>

                        <TextBlock Grid.Column="1"
               Text="~"
               Foreground="#F4D35E"
               FontSize="30"
               TextAlignment="Center"
               VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
               Text="{Binding AcDcUnit}"
               FontSize="22"
               Foreground="White"
               VerticalAlignment="Center"/>
                    </Grid>

                    <!-- DC -->
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
               Text="{Binding DcDisplayValue}"
               FontFamily="Consolas"
               FontSize="42"
               Foreground="White"
               TextAlignment="Right"/>

                        <TextBlock Grid.Column="1"
               Text="⎓"
               Foreground="#62D989"
               FontSize="30"
               TextAlignment="Center"
               VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
               Text="{Binding AcDcUnit}"
               FontSize="22"
               Foreground="White"
               VerticalAlignment="Center"/>
                    </Grid>



                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

                <TextBlock x:Name="FunctionText"
                       Text="{Binding Function}" 
                       FontSize="17"
                       Margin="0,0,20,0"/>

                <TextBlock x:Name="RangeText"
                       Text="{Binding Range}"
                       Foreground="#AAAAAA"
                       FontSize="15"
                       Margin="0,0,20,0"/>

                <TextBlock x:Name="HoldText"
                       Text="HOLD"
                       Foreground="Orange"
                       FontWeight="Bold"
                       Visibility="{Binding IsHold, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

        </Grid>
    </DockPanel>
</Window>