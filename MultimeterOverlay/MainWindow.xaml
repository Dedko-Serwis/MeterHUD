<Window x:Class="MultimeterOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MultimeterOverlay.ViewModels"
        Title="Multimeter Overlay"
        Width="560"
        Height="300"
        MinWidth="400"
        MinHeight="230"
        Background="#181818"
        Foreground="White"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter
        x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="DeviceNameText"
                   Text="{Binding DeviceName}"
                   FontSize="18"
                   Foreground="#AAAAAA"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock x:Name="ValueText"
                       Text="{Binding DisplayValue}"
                       FontSize="76"
                       FontWeight="SemiBold"
                       FontFamily="Consolas"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="UnitText"
                       Text="{Binding Unit}"
                       FontSize="24"
                       Margin="12,20,0,0"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <TextBlock x:Name="FunctionText"
                       Text="{Binding Function}" 
                       FontSize="17"
                       Margin="0,0,20,0"/>

            <TextBlock x:Name="RangeText"
                       Text="{Binding Range}"
                       Foreground="#AAAAAA"
                       FontSize="15"
                       Margin="0,0,20,0"/>

            <TextBlock x:Name="HoldText"
                       Text="HOLD"
                       Foreground="Orange"
                       FontWeight="Bold"
                       Visibility="{Binding IsHold, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Text="{Binding Status}"
                   Foreground="#AAAAAA"
                   FontSize="12"
                   HorizontalAlignment="Right"
                   Margin="0,12,0,0"/>
    </Grid>
</Window>
