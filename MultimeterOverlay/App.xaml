<Application x:Class="MultimeterOverlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MultimeterOverlay"
             xmlns:services="clr-namespace:MultimeterOverlay.Services"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ObjectDataProvider x:Key="Loc"
                        ObjectType="{x:Type services:LocalizationService}"
                        MethodName="get_Instance"/>
    </Application.Resources>
</Application>
