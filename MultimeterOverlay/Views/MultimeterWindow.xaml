<Window x:Class="MultimeterOverlay.Views.MultimeterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MultimeterOverlay.ViewModels"
        Title="Multimeter Overlay"
        Width="760"
        Height="360"
        MinWidth="650"
        MinHeight="310"
        Background="#181818"
        Foreground="White"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter
        x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Menu główne -->
        <Menu DockPanel.Dock="Top"
              Background="#252525"
              Foreground="White">

            <Menu.Resources>
                <Style TargetType="{x:Type MenuItem}">
                    <Setter Property="Foreground" Value="Black"/>
                </Style>
            </Menu.Resources>

            <MenuItem Header="Okno" Foreground="White">
                <MenuItem x:Name="OverlayTopmostMenuItem"
                          Header="Zawsze na wierzchu"
                          IsCheckable="True"
                          Click="OverlayTopmostMenuItem_Click"/>

                <MenuItem x:Name="LockOverlaySizeMenuItem"
                          Header="Zablokuj rozmiar nakładki"
                          IsCheckable="True"
                          Click="LockOverlaySizeMenuItem_Click"/>

                <MenuItem x:Name="ShowOverlayMenuItem"
                          Header="Pokaż nakładkę OBS"
                          IsCheckable="True"
                          IsChecked="True"
                          Click="ShowOverlayMenuItem_Click"/>
            </MenuItem>

            <MenuItem Header="Tryb" Foreground="White">
                <MenuItem x:Name="DisplayTestMenuItem"
                          Header="{Binding Source={StaticResource Loc}, Path=[MenuDisplayTest]}"
                          IsCheckable="True"
                          Click="DisplayTestMenuItem_Click"/>

                <MenuItem x:Name="SimulationMenuItem"
                          Header="{Binding Source={StaticResource Loc}, Path=[MenuSimulation]}"
                          IsCheckable="True"
                          Click="SimulationMenuItem_Click"/>
            </MenuItem>

            <MenuItem Header="{Binding Source={StaticResource Loc}, Path=[MenuOptions]}"
                      Foreground="White">
                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=[MenuResetSettings]}"
                          Click="ResetSettings_Click"/>

                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=[MenuOpenCsvFolder]}"
                          Click="OpenCsvFolder_Click"/>

                <Separator/>

                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=[MenuSettings]}"
                          Click="SettingsMenuItem_Click"/>
            </MenuItem>
        </Menu>


        <!-- Pasek stanu: połączenie, wskaźniki i nazwa miernika -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="#252525"
                   Foreground="#DDDDDD"
                   Padding="8,3">
            <StatusBar.Resources>
                <Style x:Key="IndicatorStyle" TargetType="Border">
                    <Setter Property="Width" Value="58"/>
                    <Setter Property="Height" Value="24"/>
                    <Setter Property="Margin" Value="3,0"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="BorderBrush" Value="#444444"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Background" Value="#202020"/>
                </Style>
            </StatusBar.Resources>

            <StatusBarItem>
                <TextBlock Text="{Binding Status}" MinWidth="210" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#999999"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
                                    <Setter Property="Foreground" Value="#39C875"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="Waiting">
                                    <Setter Property="Foreground" Value="#F4D35E"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IndicatorStyle}">
                        <TextBlock Text="AUTO" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#333333"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoRange}" Value="True">
                                            <Setter Property="Foreground" Value="#D0D0D0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource IndicatorStyle}">
                        <TextBlock Text="MIN" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#333333"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMin}" Value="True">
                                            <Setter Property="Foreground" Value="#579DFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource IndicatorStyle}">
                        <TextBlock Text="MAX" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#333333"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMax}" Value="True">
                                            <Setter Property="Foreground" Value="#579DFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="DeviceNameText"
                           Text="{Binding DeviceName}"
                           Foreground="#AAAAAA"
                           FontSize="12"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Funkcja pomiarowa nad wyświetlaczem -->
        <Grid Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="5"
                    BorderBrush="#27618A"
                    BorderThickness="1"
                    Background="#10304A"
                    Padding="10,7">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="FunctionText"
                               Text="{Binding Function}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="128"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Stałe kolumny: wartość nie przesuwa się przy zmianie jednostki -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAcDcMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="105"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ValueText"
                                   Grid.Column="0"
                                   Text="{Binding DisplayValue}"
                                   FontSize="66"
                                   FontWeight="SemiBold"
                                   FontFamily="Consolas"
                                   Foreground="White"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap" Padding="0,0,25,0"/>

                        <Border Grid.Column="1"
                                Background="#444444"
                                Height="85"
                                VerticalAlignment="Center"
                                Margin="0"/>

                        <TextBlock x:Name="UnitText"
                                   Grid.Column="2"
                                   Text="{Binding Unit}"
                                   FontSize="30"
                                   Margin="12,0,0,0"                                   
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap" 
                                   Padding="5" 
                                   TextAlignment="Center"/>
                    </Grid>

                    <!-- Dwa pomiary AC+DC -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAcDcMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding AcDisplayValue}" FontFamily="Consolas"
                                       FontSize="43" Foreground="White" TextAlignment="Right"/>
                            <TextBlock Grid.Column="1" Text="~" Foreground="#F4D35E"
                                       FontSize="30" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding AcDcUnit}" FontSize="22"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DcDisplayValue}" FontFamily="Consolas"
                                       FontSize="43" Foreground="White" TextAlignment="Right"/>
                            <TextBlock Grid.Column="1" Text="⎓" Foreground="#62D989"
                                       FontSize="30" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding AcDcUnit}" FontSize="22"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Rejestracja i licznik ramek po prawej -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="5"
                            Background="#202020" Padding="8,7" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="F12 · REC" HorizontalAlignment="Center"
                                       Foreground="#888888" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock x:Name="RecordingIndicator"
                                       Text="{Binding RecordingStatus}"
                                       FontWeight="Bold" FontSize="17"
                                       Foreground="#999999"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="5"
                            Background="#202020" Padding="8,7">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[StatusFrames]}"
                                       Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding RecordedFrames}"
                                       FontSize="21" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="5"
                            Background="#202020" Padding="8,7" Margin="0,10,0,0">
                        <TextBlock Text="HOLD" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#666666"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHold}" Value="True">
                                            <Setter Property="Foreground" Value="#F4A340"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>