<Window x:Class="MultimeterOverlay.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Source={StaticResource Loc}, Path=[AboutTitle]}"
        Width="460" Height="330" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#181818" Foreground="White">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{Binding Source={StaticResource Loc}, Path=[ButtonClose]}" Width="90" Height="30" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="MeterHUD" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="by DEDKO Serwis" Foreground="#AAAAAA" Margin="0,0,0,14"/>
            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[AboutDescription]}" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[AboutCopyright]}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[AboutLicense]}" Margin="0,0,0,8"/>
            <TextBlock Margin="0,0,0,8">
                <Hyperlink Click="License_Click"><TextBlock Text="{Binding Source={StaticResource Loc}, Path=[AboutLicenseLink]}"/></Hyperlink>
            </TextBlock>
            <TextBlock>
                <Hyperlink Click="Repository_Click"><TextBlock Text="{Binding Source={StaticResource Loc}, Path=[AboutRepository]}"/></Hyperlink>
            </TextBlock>
        </StackPanel>
    </DockPanel>
</Window>
