<Window x:Class="MultimeterOverlay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:MultimeterOverlay.Services"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding Source={StaticResource Loc}, Path=[SettingsTitle]}"        
        Width="480"
        Height="480"
        MinWidth="420"
        MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#181818"
        Foreground="White">

    <DockPanel Margin="20">

        <!-- Przyciski -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="{Binding Source={StaticResource Loc}, Path=[ButtonCancel]}"
                    Width="90"
                    Height="30"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="Cancel_Click"/>

            <Button Content="{Binding Source={StaticResource Loc}, Path=[ButtonSave]}"
                    Width="90"
                    Height="30"
                    IsDefault="True"
                    Click="Save_Click"/>
        </StackPanel>

        <!-- Ustawienia -->
        <StackPanel>

            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[SettingsGeneral]}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,15"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Source={StaticResource Loc}, Path=[SettingsLanguage]}"
                           VerticalAlignment="Center"/>

                <ComboBox Grid.Column="1"
                          Height="28"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding Language,
                              Mode=TwoWay,
                              UpdateSourceTrigger=PropertyChanged}">

                    <ComboBoxItem Content="Polski"
                                  Tag="pl"/>

                    <ComboBoxItem Content="English"
                                  Tag="en"/>

                </ComboBox>
            </Grid>

            <Separator Margin="0,20,0,15"/>

            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[SettingsDisplay]}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#AAAAAA"/>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="65"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Tło nakładki" VerticalAlignment="Center"/>
                <TextBox x:Name="BackgroundColorTextBox" Grid.Row="0" Grid.Column="1"
                         Margin="0,4,8,4" VerticalContentAlignment="Center"
                         Text="{Binding OverlayBackgroundColor, UpdateSourceTrigger=PropertyChanged}"/>
                <Button x:Name="BackgroundColorButton" Grid.Row="0" Grid.Column="2"
                        Content="RGB..." Click="BackgroundColor_Click"/>

                <TextBlock Grid.Row="1" Text="Cyfry i jednostki" VerticalAlignment="Center"/>
                <TextBox x:Name="TextColorTextBox" Grid.Row="1" Grid.Column="1"
                         Margin="0,4,8,4" VerticalContentAlignment="Center"
                         Text="{Binding OverlayTextColor, UpdateSourceTrigger=PropertyChanged}"/>
                <Button x:Name="TextColorButton" Grid.Row="1" Grid.Column="2"
                        Content="RGB..." Click="TextColor_Click"/>

                <TextBlock Grid.Row="2" Text="Ramka - połączono" VerticalAlignment="Center"/>
                <TextBox x:Name="ConnectedColorTextBox" Grid.Row="2" Grid.Column="1"
                         Margin="0,4,8,4" VerticalContentAlignment="Center"
                         Text="{Binding OverlayConnectedColor, UpdateSourceTrigger=PropertyChanged}"/>
                <Button x:Name="ConnectedColorButton" Grid.Row="2" Grid.Column="2"
                        Content="RGB..." Click="ConnectedColor_Click"/>

                <TextBlock Grid.Row="3" Text="Ramka - oczekiwanie" VerticalAlignment="Center"/>
                <TextBox x:Name="WaitingColorTextBox" Grid.Row="3" Grid.Column="1"
                         Margin="0,4,8,4" VerticalContentAlignment="Center"
                         Text="{Binding OverlayWaitingColor, UpdateSourceTrigger=PropertyChanged}"/>
                <Button x:Name="WaitingColorButton" Grid.Row="3" Grid.Column="2"
                        Content="RGB..." Click="WaitingColor_Click"/>

                <TextBlock Grid.Row="4" Text="Ramka - rozłączono" VerticalAlignment="Center"/>
                <TextBox x:Name="DisconnectedColorTextBox" Grid.Row="4" Grid.Column="1"
                         Margin="0,4,8,4" VerticalContentAlignment="Center"
                         Text="{Binding OverlayDisconnectedColor, UpdateSourceTrigger=PropertyChanged}"/>
                <Button x:Name="DisconnectedColorButton" Grid.Row="4" Grid.Column="2"
                        Content="RGB..." Click="DisconnectedColor_Click"/>
            </Grid>

            <Button Content="Domyślne kolory" HorizontalAlignment="Left"
                    Margin="0,12,0,0" Padding="10,5" Click="DefaultColors_Click"/>

        </StackPanel>

    </DockPanel>
</Window>
