<Window x:Class="MultimeterOverlay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ustawienia"
        Width="480"
        Height="300"
        MinWidth="420"
        MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#181818"
        Foreground="White">

    <DockPanel Margin="20">

        <!-- Przyciski -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Anuluj"
                    Width="90"
                    Height="30"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="Cancel_Click"/>

            <Button Content="Zapisz"
                    Width="90"
                    Height="30"
                    IsDefault="True"
                    Click="Save_Click"/>
        </StackPanel>

        <!-- Ustawienia -->
        <StackPanel>

            <TextBlock Text="Ogólne"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,15"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Język aplikacji:"
                           VerticalAlignment="Center"/>

                <ComboBox Grid.Column="1"
                          Height="28"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding Language,
                              Mode=TwoWay,
                              UpdateSourceTrigger=PropertyChanged}">

                    <ComboBoxItem Content="Polski"
                                  Tag="pl"/>

                    <ComboBoxItem Content="English"
                                  Tag="en"/>

                </ComboBox>
            </Grid>

            <Separator Margin="0,20,0,15"/>

            <TextBlock Text="Wyświetlacz OBS"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#AAAAAA"/>

            <TextBlock Text="Opcje wyświetlacza dodamy w kolejnym etapie."
                       Foreground="#777777"
                       Margin="0,8,0,0"/>

        </StackPanel>

    </DockPanel>
</Window>
