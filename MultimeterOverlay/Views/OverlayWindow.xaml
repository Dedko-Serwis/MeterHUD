<Window x:Class="MultimeterOverlay.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multimeter OBS Overlay"
        Width="360"
        Height="160"
        MinWidth="260"
        MinHeight="110"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#181818"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <Style x:Key="IndicatorStyle"
               TargetType="Border">
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="IndicatorTextStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="AutoStyle"
               TargetType="Border"
               BasedOn="{StaticResource IndicatorStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAutoRange}"
                             Value="True">
                    <Setter Property="Background" Value="#666666"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ManualStyle"
               TargetType="Border"
               BasedOn="{StaticResource IndicatorStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsManualRange}"
                             Value="True">
                    <Setter Property="Background" Value="#666666"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DCStyle"
               TargetType="Border"
               BasedOn="{StaticResource IndicatorStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDC}" Value="True">
                    <Setter Property="Background" Value="#228B50"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ACStyle"
               TargetType="Border"
               BasedOn="{StaticResource IndicatorStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAC}" Value="True">
                    <Setter Property="Background" Value="#C49A16"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MinStyle"
               TargetType="Border"
               BasedOn="{StaticResource IndicatorStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMin}" Value="True">
                    <Setter Property="Background" Value="#2563B5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaxStyle"
               TargetType="Border"
               BasedOn="{StaticResource IndicatorStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMax}" Value="True">
                    <Setter Property="Background" Value="#2563B5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HoldStyle"
               TargetType="Border"
               BasedOn="{StaticResource IndicatorStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHold}" Value="True">
                    <Setter Property="Background" Value="#D97706"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource IndicatorTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAutoRange}"
                             Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ManualTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource IndicatorTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsManualRange}"
                             Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DCTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource IndicatorTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDC}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ACTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource IndicatorTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAC}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MinTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource IndicatorTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMin}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaxTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource IndicatorTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMax}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HoldTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource IndicatorTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHold}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Status komunikacji -->
        <Style x:Key="ConnectionStatusStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}"
                             Value="Połączono">
                    <Setter Property="Foreground" Value="#39C875"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Miernik niedostępny">
                    <Setter Property="Foreground" Value="#E05252"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Utracono połączenie">
                    <Setter Property="Foreground" Value="#E05252"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Brak odpowiedzi miernika">
                    <Setter Property="Foreground" Value="#E05252"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Rozłączono">
                    <Setter Property="Foreground" Value="#E05252"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border Background="#181818"
            BorderBrush="#555555"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8">

        <Viewbox Stretch="Uniform"
                 StretchDirection="Both">

            <Grid Width="330" Height="140">

                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>

                <!-- AUTO / MANUAL -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">

                    <Border Style="{StaticResource AutoStyle}">
                        <TextBlock Text="AUTO"
                                   Style="{StaticResource ActiveTextStyle}"/>
                    </Border>

                    <Border Style="{StaticResource ManualStyle}">
                        <TextBlock Text="MANUAL"
                                   Style="{StaticResource ManualTextStyle}"/>
                    </Border>
                </StackPanel>

                <!-- AC / DC -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Border Style="{StaticResource DCStyle}">
                        <TextBlock Text="DC"
                                   Style="{StaticResource DCTextStyle}"/>
                    </Border>

                    <Border Style="{StaticResource ACStyle}">
                        <TextBlock Text="AC"
                                   Style="{StaticResource ACTextStyle}"/>
                    </Border>
                </StackPanel>

                <!-- GŁÓWNA CZĘŚĆ -->
                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- MIN / MAX / HOLD -->
                    <StackPanel Grid.Column="0"
                                Orientation="Vertical"
                                VerticalAlignment="Center">

                        <Border Style="{StaticResource MinStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,2">
                            <TextBlock Text="MIN"
                                       Style="{StaticResource MinTextStyle}"/>
                        </Border>

                        <Border Style="{StaticResource MaxStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,2">
                            <TextBlock Text="MAX"
                                       Style="{StaticResource MaxTextStyle}"/>
                        </Border>

                        <Border Style="{StaticResource HoldStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,2">
                            <TextBlock Text="HOLD"
                                       Style="{StaticResource HoldTextStyle}"/>
                        </Border>
                    </StackPanel>

                    <!-- POMIAR -->

                    <!-- POMIAR -->
                    <Grid Grid.Column="1"
      VerticalAlignment="Center"
      HorizontalAlignment="Stretch">

                        <Grid.ColumnDefinitions>
                            <!-- Wartość pomiaru -->
                            <ColumnDefinition Width="195"/>

                            <!-- Jednostka -->
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <!-- WARTOŚĆ -->
                        <TextBlock Grid.Column="0"
               Text="{Binding DisplayValue}"
               FontFamily="Consolas"
               FontSize="47"
               FontWeight="SemiBold"
               Foreground="White"
               TextAlignment="Right"
               VerticalAlignment="Center"
               TextTrimming="None"
               TextWrapping="NoWrap"/>

                        <!-- JEDNOSTKA -->
                        <TextBlock Grid.Column="1"
               Text="{Binding OverlayUnit}"
               FontSize="26"
               Foreground="White"
               TextAlignment="Center"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Center"
               TextWrapping="NoWrap"/>

                    </Grid>

                </Grid>

                <!-- STATUS -->
                <TextBlock Grid.Row="2"
                           Text="{Binding Status}"
                           Style="{StaticResource ConnectionStatusStyle}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>

            </Grid>
        </Viewbox>
    </Border>
</Window>
