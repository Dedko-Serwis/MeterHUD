<Window x:Class="MultimeterOverlay.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multimeter OBS Overlay"
        Width="440"
        Height="160"
        MinWidth="260"
        MinHeight="110"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="#CC181818"
            BorderBrush="#555555"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10">

        <Viewbox Stretch="Uniform"
                 StretchDirection="Both">

            <Grid Width="400" Height="120">
                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding DisplayValue}"
                               Foreground="White"
                               FontFamily="Consolas"
                               FontWeight="SemiBold"
                               FontSize="64"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding Unit}"
                               Foreground="White"
                               FontSize="22"
                               Margin="10,18,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding Function}"
                               Foreground="#CCCCCC"
                               FontSize="14"
                               Margin="0,0,14,0"/>

                    <TextBlock Text="{Binding Range}"
                               Foreground="#AAAAAA"
                               FontSize="14"
                               Margin="0,0,14,0"/>

                    <TextBlock Text="HOLD"
                               Foreground="Orange"
                               FontSize="14"
                               FontWeight="Bold"
                               Visibility="{Binding IsHold,
                                   Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Viewbox>
    </Border>
</Window>
