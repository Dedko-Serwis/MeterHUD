<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyTitle>MeterHUD</AssemblyTitle>
    <Product>MeterHUD</Product>
    <Company>DEDKO Serwis</Company>
    <Authors>DEDKO Serwis</Authors>
    <Copyright>Copyright © 2026 DEDKO Serwis</Copyright>
    <Description>Open-source multimeter monitor and OBS overlay</Description>
    <Version>1.0.1</Version>
    <ApplicationIcon>MeterHUD_mixed.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Languages\\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="MeterHUD_mixed.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeterHUD.Core\MeterHUD.Core.csproj" />
    <ProjectReference Include="..\MeterHUD.Devices.UT161E\MeterHUD.Devices.UT161E.csproj" />
  </ItemGroup>

</Project>
