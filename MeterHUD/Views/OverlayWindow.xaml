<Window x:Class="MeterHUD.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:services="clr-namespace:MeterHUD.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeterHUD"
        Width="500"
        Height="180"
        MinWidth="250"
        MinHeight="90"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource OverlayBackgroundBrush}"
        BorderThickness="0"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        Left="0"
        Top="0"
        UseLayoutRounding="False"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <Style x:Key="IndicatorStyle"
               TargetType="Border">
            <Setter Property="Background" Value="{x:Static services:AppColors.Ui202020Brush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="IndicatorTextStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="{x:Static services:AppColors.Ui777777Brush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="DCStyle"
               TargetType="Border"
               BasedOn="{StaticResource IndicatorStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDC}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource OverlayDcBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ACStyle"
               TargetType="Border"
               BasedOn="{StaticResource IndicatorStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAC}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource OverlayAcBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MinStyle"
               TargetType="Border"
               BasedOn="{StaticResource IndicatorStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMin}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource OverlayMinMaxBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaxStyle"
               TargetType="Border"
               BasedOn="{StaticResource IndicatorStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMax}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource OverlayMinMaxBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HoldStyle"
               TargetType="Border"
               BasedOn="{StaticResource IndicatorStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHold}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource OverlayHoldBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource IndicatorTextStyle}">
            <Setter Property="Foreground" Value="{x:Static services:AppColors.Ui555555Brush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAutoRange}"
                             Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource OverlayRangeTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ManualTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource IndicatorTextStyle}">
            <Setter Property="Foreground" Value="{x:Static services:AppColors.Ui555555Brush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsManualRange}"
                             Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource OverlayRangeTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DCTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource IndicatorTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDC}" Value="True">
                    <Setter Property="Foreground" Value="{x:Static services:AppColors.UiWhiteBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ACTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource IndicatorTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAC}" Value="True">
                    <Setter Property="Foreground" Value="{x:Static services:AppColors.UiWhiteBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MinTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource IndicatorTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMin}" Value="True">
                    <Setter Property="Foreground" Value="{x:Static services:AppColors.UiWhiteBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaxTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource IndicatorTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMax}" Value="True">
                    <Setter Property="Foreground" Value="{x:Static services:AppColors.UiWhiteBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HoldTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource IndicatorTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHold}" Value="True">
                    <Setter Property="Foreground" Value="{x:Static services:AppColors.UiWhiteBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>


    <Border Background="{DynamicResource OverlayBackgroundBrush}"
        BorderThickness="5"
        CornerRadius="5"
        Padding="5">

        <Border.Style>
            <Style TargetType="Border">

                <!-- Domyślnie: brak komunikacji -->
                <Setter Property="BorderBrush"
                    Value="{DynamicResource OverlayDisconnectedBrush}"/>

                <Style.Triggers>

                    <!-- Połączono -->
                    <DataTrigger Binding="{Binding ConnectionState}"             Value="Connected">
                        <Setter Property="BorderBrush" Value="{DynamicResource OverlayConnectedBrush}"/>
                    </DataTrigger>
                    
                    <!-- Oczekiwanie na miernik -->
                    <DataTrigger Binding="{Binding ConnectionState}"             Value="Waiting">
                        <Setter Property="BorderBrush" Value="{DynamicResource OverlayWaitingBrush}"/>
                    </DataTrigger>
                    
                </Style.Triggers>
            </Style>
        </Border.Style>

        <!-- Tutaj pozostaje istniejący Viewbox -->

    <Viewbox Stretch="Uniform"
                 StretchDirection="Both">

            <Grid Width="330" Height="110">
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="94"/>
                </Grid.RowDefinitions>

                <!-- AUTO: sam tekst, bez tła i ramki -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <TextBlock Text="AUTO"
                               Style="{StaticResource ActiveTextStyle}"
                               VerticalAlignment="Center"
                               Margin="6,0,12,0"/>
                </StackPanel>

                <!-- AC / DC -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Border Style="{StaticResource ACStyle}">
                        <TextBlock Text="AC" Style="{StaticResource ACTextStyle}" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource DCStyle}">
                        <TextBlock Text="DC" Style="{StaticResource DCTextStyle}" VerticalAlignment="Center"/>
                    </Border>


                </StackPanel>

                <!-- GŁÓWNA CZĘŚĆ -->
                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- MIN / MAX / HOLD -->
                    <StackPanel Grid.Column="0"
                                Orientation="Vertical"
                                VerticalAlignment="Center">

                        <Border Style="{StaticResource MinStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,2">
                            <TextBlock Text="MIN"
                                       Style="{StaticResource MinTextStyle}" VerticalAlignment="Center" Width="35" TextAlignment="Center"/>
                        </Border>

                        <Border Style="{StaticResource MaxStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,2">
                            <TextBlock Text="MAX"
                                       Style="{StaticResource MaxTextStyle}" VerticalAlignment="Center" Width="35" TextAlignment="Center"/>
                        </Border>

                        <Border Style="{StaticResource HoldStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,2">
                            <TextBlock Text="HOLD"
                                       Style="{StaticResource HoldTextStyle}" VerticalAlignment="Center" Width="35" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- POMIAR -->
                    <Grid Grid.Column="1"       VerticalAlignment="Center"      HorizontalAlignment="Stretch">

                        <!-- Pojedynczy pomiar -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAcDcMode}"
                                 Value="True">
                                            <Setter Property="Visibility"
                                Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="195"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                   Text="{Binding DisplayValue}"
                   FontFamily="Consolas"
                   FontSize="47"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource OverlayTextBrush}"
                   TextAlignment="Right"
                   VerticalAlignment="Center"
                   TextWrapping="NoWrap"/>

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition>
                                        <RowDefinition.Style>
                                            <Style TargetType="RowDefinition">
                                                <Setter Property="Height" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDiodeMode}" Value="True">
                                                        <Setter Property="Height" Value="0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RowDefinition.Style>
                                    </RowDefinition>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Viewbox Grid.Row="1" Panel.ZIndex="1" Width="26" Height="12" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                                    <Viewbox.RenderTransform><TranslateTransform Y="-11"/></Viewbox.RenderTransform>
                                    <Path Data="M 2,11 L 12,11 M 12,2 L 12,20 L 31,11 Z M 31,2 L 31,20 M 31,11 L 42,11"
                                          Stroke="{DynamicResource OverlayDiodeBrush}"
                                          StrokeThickness="2.5" StrokeLineJoin="Round">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDiodeMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Viewbox>
                                <TextBlock Grid.Row="1" Text="{Binding OverlayUnit}"
                                           FontSize="26" Foreground="{DynamicResource OverlayTextBrush}"
                                           TextAlignment="Center" TextWrapping="NoWrap"/>
                            </Grid>
                        </Grid>

                        <!-- Dwa pomiary AC+DC: przesunięcie całego bloku w lewo i lekko w górę -->
                        <Grid Margin="-14,-8,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAcDcMode}"
                                 Value="True">
                                            <Setter Property="Visibility"
                                Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="45"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="195"/>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>



                            <!-- AC -->
                            <TextBlock Grid.Row="0"
           Grid.Column="0"
           Text="{Binding AcDisplayValue}"
           FontFamily="Consolas"
           FontSize="31"
           Foreground="{DynamicResource OverlayTextBrush}"
           TextAlignment="Right"
           VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="0"
           Grid.Column="1"
           Text="~"
           Foreground="{DynamicResource OverlayAcBrush}"
           FontSize="25"
           TextAlignment="Center"
           VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="0"
           Grid.Column="2"
           Text="{Binding AcDcUnit}"
           FontSize="21"
           Foreground="{DynamicResource OverlayTextBrush}"
           TextAlignment="Left"
           VerticalAlignment="Center"/>

                            <!-- DC -->
                            <TextBlock Grid.Row="1"
           Grid.Column="0"
           Text="{Binding DcDisplayValue}"
           FontFamily="Consolas"
           FontSize="31"
           Foreground="{DynamicResource OverlayTextBrush}"
           TextAlignment="Right"
           VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1"
           Grid.Column="1"
           Text="⎓"
           Foreground="{DynamicResource OverlayDcBrush}"
           FontSize="25"
           TextAlignment="Center"
           VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1"
           Grid.Column="2"
           Text="{Binding AcDcUnit}"
           FontSize="21"
           Foreground="{DynamicResource OverlayTextBrush}"
           TextAlignment="Left"
           VerticalAlignment="Center"/>


                        </Grid>

                    </Grid>

                </Grid>
            </Grid>
        </Viewbox>
    </Border>
</Window>
