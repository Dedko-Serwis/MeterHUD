<Window x:Class="MeterHUD.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:MeterHUD.Services"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding Source={StaticResource Loc}, Path=[SettingsTitle]}"        
        Width="750"
        Height="500"
        MinWidth="650"
        MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{x:Static services:AppColors.Ui181818Brush}"
        Foreground="{x:Static services:AppColors.UiWhiteBrush}">

    <DockPanel Margin="20">

        <!-- Przyciski -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="{Binding Source={StaticResource Loc}, Path=[ButtonSave]}"
                    Width="90" Height="30" Margin="0,0,10,0"
                    IsDefault="True" Click="Save_Click"/>

            <Button Content="{Binding Source={StaticResource Loc}, Path=[ButtonCancel]}"
                    Width="90" Height="30" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>

        <!-- Zakładki ustawień -->
        <TabControl>
            <TabItem Header="{Binding Source={StaticResource Loc}, Path=[SettingsColors]}">
                <StackPanel Margin="12,16,12,0">
                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[SettingsOverlayColors]}"
                               FontSize="18" FontWeight="SemiBold"
                               Margin="0,0,0,18"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[SettingsDisplayFrame]}"
                                       FontWeight="SemiBold" Foreground="{x:Static services:AppColors.UiAAAAAABrush}"
                                       Margin="0,0,0,8"/>
<Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="175"/>
        <ColumnDefinition Width="95"/>
        <ColumnDefinition Width="40"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="{Binding Source={StaticResource Loc}, Path=[SettingsOverlayBackground]}" VerticalAlignment="Center"/>
    <TextBox x:Name="BackgroundColorTextBox" Grid.Row="0" Grid.Column="1"
                         Margin="0,3,6,3" VerticalContentAlignment="Center"
                         Text="{Binding OverlayBackgroundColor, UpdateSourceTrigger=PropertyChanged}"/>
    <Button x:Name="BackgroundColorButton" Grid.Row="0" Grid.Column="2"
                        Content="" ToolTip="{Binding Source={StaticResource Loc}, Path=[SettingsPickColor]}" Click="BackgroundColor_Click" Padding="0" Height="20" VerticalAlignment="Center"/>
    <TextBlock Grid.Row="1" Text="{Binding Source={StaticResource Loc}, Path=[SettingsDigitsUnits]}" VerticalAlignment="Center"/>
    <TextBox x:Name="TextColorTextBox" Grid.Row="1" Grid.Column="1"
                         Margin="0,3,6,3" VerticalContentAlignment="Center"
                         Text="{Binding OverlayTextColor, UpdateSourceTrigger=PropertyChanged}"/>
    <Button x:Name="TextColorButton" Grid.Row="1" Grid.Column="2"
                        Content="" ToolTip="{Binding Source={StaticResource Loc}, Path=[SettingsPickColor]}" Click="TextColor_Click" Padding="0" Height="20" VerticalAlignment="Center"/>
    <TextBlock Grid.Row="2" Text="{Binding Source={StaticResource Loc}, Path=[SettingsBorderConnected]}" VerticalAlignment="Center"/>
    <TextBox x:Name="ConnectedColorTextBox" Grid.Row="2" Grid.Column="1"
                         Margin="0,3,6,3" VerticalContentAlignment="Center"
                         Text="{Binding OverlayConnectedColor, UpdateSourceTrigger=PropertyChanged}"/>
    <Button x:Name="ConnectedColorButton" Grid.Row="2" Grid.Column="2"
                        Content="" ToolTip="{Binding Source={StaticResource Loc}, Path=[SettingsPickColor]}" Click="ConnectedColor_Click" Padding="0" Height="20" VerticalAlignment="Center"/>
    <TextBlock Grid.Row="3" Text="{Binding Source={StaticResource Loc}, Path=[SettingsBorderWaiting]}" VerticalAlignment="Center"/>
    <TextBox x:Name="WaitingColorTextBox" Grid.Row="3" Grid.Column="1"
                         Margin="0,3,6,3" VerticalContentAlignment="Center"
                         Text="{Binding OverlayWaitingColor, UpdateSourceTrigger=PropertyChanged}"/>
    <Button x:Name="WaitingColorButton" Grid.Row="3" Grid.Column="2"
                        Content="" ToolTip="{Binding Source={StaticResource Loc}, Path=[SettingsPickColor]}" Click="WaitingColor_Click" Padding="0" Height="20" VerticalAlignment="Center"/>
    <TextBlock Grid.Row="4" Text="{Binding Source={StaticResource Loc}, Path=[SettingsBorderDisconnected]}" VerticalAlignment="Center"/>
    <TextBox x:Name="DisconnectedColorTextBox" Grid.Row="4" Grid.Column="1"
                         Margin="0,3,6,3" VerticalContentAlignment="Center"
                         Text="{Binding OverlayDisconnectedColor, UpdateSourceTrigger=PropertyChanged}"/>
    <Button x:Name="DisconnectedColorButton" Grid.Row="4" Grid.Column="2"
                        Content="" ToolTip="{Binding Source={StaticResource Loc}, Path=[SettingsPickColor]}" Click="DisconnectedColor_Click" Padding="0" Height="20" VerticalAlignment="Center"/>
</Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[SettingsIndicators]}"
                                       FontWeight="SemiBold" Foreground="{x:Static services:AppColors.UiAAAAAABrush}"
                                       Margin="0,0,0,8"/>
<Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="175"/>
        <ColumnDefinition Width="95"/>
        <ColumnDefinition Width="40"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="{Binding Source={StaticResource Loc}, Path=[SettingsAutoManualText]}" VerticalAlignment="Center"/>
    <TextBox x:Name="RangeTextColorTextBox" Grid.Row="0" Grid.Column="1"
                         Margin="0,3,6,3" VerticalContentAlignment="Center"
                         Text="{Binding OverlayRangeTextColor, UpdateSourceTrigger=PropertyChanged}"/>
    <Button x:Name="RangeTextColorButton" Grid.Row="0" Grid.Column="2"
                        Content="" ToolTip="{Binding Source={StaticResource Loc}, Path=[SettingsPickColor]}" Click="RangeTextColor_Click" Padding="0" Height="20" VerticalAlignment="Center"/>
    <TextBlock Grid.Row="1" Text="{Binding Source={StaticResource Loc}, Path=[SettingsMinMaxBackground]}" VerticalAlignment="Center"/>
    <TextBox x:Name="MinMaxColorTextBox" Grid.Row="1" Grid.Column="1"
                         Margin="0,3,6,3" VerticalContentAlignment="Center"
                         Text="{Binding OverlayMinMaxColor, UpdateSourceTrigger=PropertyChanged}"/>
    <Button x:Name="MinMaxColorButton" Grid.Row="1" Grid.Column="2"
                        Content="" ToolTip="{Binding Source={StaticResource Loc}, Path=[SettingsPickColor]}" Click="MinMaxColor_Click" Padding="0" Height="20" VerticalAlignment="Center"/>
    <TextBlock Grid.Row="2" Text="{Binding Source={StaticResource Loc}, Path=[SettingsAcBackground]}" VerticalAlignment="Center"/>
    <TextBox x:Name="AcColorTextBox" Grid.Row="2" Grid.Column="1"
                         Margin="0,3,6,3" VerticalContentAlignment="Center"
                         Text="{Binding OverlayAcColor, UpdateSourceTrigger=PropertyChanged}"/>
    <Button x:Name="AcColorButton" Grid.Row="2" Grid.Column="2"
                        Content="" ToolTip="{Binding Source={StaticResource Loc}, Path=[SettingsPickColor]}" Click="AcColor_Click" Padding="0" Height="20" VerticalAlignment="Center"/>
    <TextBlock Grid.Row="3" Text="{Binding Source={StaticResource Loc}, Path=[SettingsDcBackground]}" VerticalAlignment="Center"/>
    <TextBox x:Name="DcColorTextBox" Grid.Row="3" Grid.Column="1"
                         Margin="0,3,6,3" VerticalContentAlignment="Center"
                         Text="{Binding OverlayDcColor, UpdateSourceTrigger=PropertyChanged}"/>
    <Button x:Name="DcColorButton" Grid.Row="3" Grid.Column="2"
                        Content="" ToolTip="{Binding Source={StaticResource Loc}, Path=[SettingsPickColor]}" Click="DcColor_Click" Padding="0" Height="20" VerticalAlignment="Center"/>
    <TextBlock Grid.Row="4" Text="{Binding Source={StaticResource Loc}, Path=[SettingsHoldBackground]}" VerticalAlignment="Center"/>
    <TextBox x:Name="HoldColorTextBox" Grid.Row="4" Grid.Column="1"
                         Margin="0,3,6,3" VerticalContentAlignment="Center"
                         Text="{Binding OverlayHoldColor, UpdateSourceTrigger=PropertyChanged}"/>
    <Button x:Name="HoldColorButton" Grid.Row="4" Grid.Column="2"
                        Content="" ToolTip="{Binding Source={StaticResource Loc}, Path=[SettingsPickColor]}" Click="HoldColor_Click" Padding="0" Height="20" VerticalAlignment="Center"/>
</Grid>
                        </StackPanel>
                    </Grid>
                    <Button Content="{Binding Source={StaticResource Loc}, Path=[SettingsDefaultColors]}"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0" Padding="10,5"
                            Click="DefaultColors_Click"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="{Binding Source={StaticResource Loc}, Path=[SettingsPaths]}">
                <StackPanel Margin="12,16,12,0">
                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[SettingsFilePaths]}"
                               FontSize="18" FontWeight="SemiBold"
                               Margin="0,0,0,18"/>
                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[SettingsCsvSaveFolder]}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,10,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding CsvDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Height="30" Content="{Binding Source={StaticResource Loc}, Path=[SettingsBrowse]}"
                                Click="BrowseCsvDirectory_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="{Binding Source={StaticResource Loc}, Path=[SettingsDefaultFolder]}" Padding="12,6" Margin="0,0,10,0"
                                Click="DefaultCsvDirectory_Click"/>
                        <Button Content="{Binding Source={StaticResource Loc}, Path=[SettingsOpenFolder]}" Padding="12,6"
                                Click="OpenCsvDirectory_Click"/>
                    </StackPanel>
                    <Button Content="{Binding Source={StaticResource Loc}, Path=[SettingsDeleteCsv]}" HorizontalAlignment="Left"
                            Margin="0,18,0,0" Padding="12,6"
                            Click="DeleteCsvFiles_Click"/>
                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[SettingsDeleteCsvHint]}"
                               Foreground="{x:Static services:AppColors.UiAAAAAABrush}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[SettingsPathChangeHint]}"
                               Foreground="{x:Static services:AppColors.UiAAAAAABrush}" Margin="0,18,0,0"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="{Binding Source={StaticResource Loc}, Path=[SettingsLanguageTab]}">
                <StackPanel Margin="12,16,12,0">
                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[SettingsLanguageHeading]}"
                               FontSize="18" FontWeight="SemiBold"
                               Margin="0,0,0,18"/>
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[SettingsLanguage]}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Height="28"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="Polski" Tag="pl"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
