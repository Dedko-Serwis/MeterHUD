<Window x:Class="MeterHUD.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Source={StaticResource Loc}, Path=[UpdateTitle]}" Width="560" Height="480"
        MinWidth="500" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="#202020" Foreground="#DDDDDD">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[UpdateInstalled]}" Foreground="#AAAAAA"/>
                <TextBlock x:Name="CurrentVersionText" FontSize="22" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[UpdateLatest]}" Foreground="#AAAAAA"/>
                <TextBlock x:Name="LatestVersionText" Text="—" FontSize="22" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" x:Name="StatusText" Text="{Binding Source={StaticResource Loc}, Path=[UpdateUnchecked]}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>
        <GroupBox Grid.Row="2" Header="{Binding Source={StaticResource Loc}, Path=[UpdateNotes]}" Foreground="#DDDDDD"
                  Margin="0,0,0,10">
            <ScrollViewer Height="105" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" Padding="8" Foreground="#DDDDDD"/>
            </ScrollViewer>
        </GroupBox>
        <StackPanel Grid.Row="3">
            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[UpdateAutomatic]}" Margin="0,0,0,5"/>
            <ComboBox x:Name="IntervalCombo" Width="240" HorizontalAlignment="Left"
                      SelectionChanged="IntervalCombo_SelectionChanged">
                <ComboBoxItem Content="{Binding Source={StaticResource Loc}, Path=[UpdateStartup]}" Tag="-1"/>
                <ComboBoxItem Content="{Binding Source={StaticResource Loc}, Path=[UpdateEvery7]}" Tag="7"/>
                <ComboBoxItem Content="{Binding Source={StaticResource Loc}, Path=[UpdateEvery30]}" Tag="30"/>
                <ComboBoxItem Content="{Binding Source={StaticResource Loc}, Path=[UpdateDisabled]}" Tag="0"/>
            </ComboBox>
            <TextBlock x:Name="LastCheckText" Foreground="#AAAAAA" Margin="0,10,0,0"/>
        </StackPanel>
        <ProgressBar Grid.Row="4" x:Name="DownloadProgress" Height="12" Minimum="0" Maximum="100"
                     Visibility="Collapsed" Margin="0,12,0,8"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CheckButton" Content="{Binding Source={StaticResource Loc}, Path=[UpdateCheck]}" Click="Check_Click" Padding="14,7" Margin="0,0,8,0"/>
            <Button x:Name="InstallButton" Content="{Binding Source={StaticResource Loc}, Path=[UpdateInstall]}" Click="Install_Click" Padding="14,7"
                    Margin="0,0,8,0" IsEnabled="False"/>
            <Button Content="{Binding Source={StaticResource Loc}, Path=[ButtonClose]}" Click="Close_Click" Padding="14,7"/>
        </StackPanel>
    </Grid>
</Window>
