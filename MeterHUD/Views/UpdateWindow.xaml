<Window x:Class="MeterHUD.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeterHUD — Aktualizacja" Width="560" Height="480"
        MinWidth="500" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="#202020" Foreground="#DDDDDD">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Zainstalowana wersja / Installed" Foreground="#AAAAAA"/>
                <TextBlock x:Name="CurrentVersionText" FontSize="22" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Najnowsza wersja / Latest" Foreground="#AAAAAA"/>
                <TextBlock x:Name="LatestVersionText" Text="—" FontSize="22" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" x:Name="StatusText" Text="Nie sprawdzono aktualizacji."
                   TextWrapping="Wrap" Margin="0,0,0,12"/>
        <GroupBox Grid.Row="2" Header="Informacje o wydaniu / Release notes" Foreground="#DDDDDD"
                  Margin="0,0,0,10">
            <ScrollViewer Height="105" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" Padding="8" Foreground="#DDDDDD"/>
            </ScrollViewer>
        </GroupBox>
        <StackPanel Grid.Row="3">
            <TextBlock Text="Automatyczne sprawdzanie / Automatic check" Margin="0,0,0,5"/>
            <ComboBox x:Name="IntervalCombo" Width="240" HorizontalAlignment="Left"
                      SelectionChanged="IntervalCombo_SelectionChanged">
                <ComboBoxItem Content="Przy uruchamianiu / On startup" Tag="-1"/>
                <ComboBoxItem Content="Co 7 dni / Every 7 days" Tag="7"/>
                <ComboBoxItem Content="Co 30 dni / Every 30 days" Tag="30"/>
                <ComboBoxItem Content="Nie sprawdzaj / Disabled" Tag="0"/>
            </ComboBox>
            <TextBlock x:Name="LastCheckText" Foreground="#AAAAAA" Margin="0,10,0,0"/>
        </StackPanel>
        <ProgressBar Grid.Row="4" x:Name="DownloadProgress" Height="12" Minimum="0" Maximum="100"
                     Visibility="Collapsed" Margin="0,12,0,8"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CheckButton" Content="Sprawdź teraz" Click="Check_Click" Padding="14,7" Margin="0,0,8,0"/>
            <Button x:Name="InstallButton" Content="Aktualizuj" Click="Install_Click" Padding="14,7"
                    Margin="0,0,8,0" IsEnabled="False"/>
            <Button Content="Zamknij" Click="Close_Click" Padding="14,7"/>
        </StackPanel>
    </Grid>
</Window>
