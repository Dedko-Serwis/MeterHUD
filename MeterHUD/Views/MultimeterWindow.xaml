<Window x:Class="MeterHUD.Views.MultimeterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:services="clr-namespace:MeterHUD.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MeterHUD.ViewModels"
        Title="MeterHUD by DEDKO Serwis"
        Width="650"
        Height="350"
        MinWidth="650"
        MinHeight="350"
        Background="{DynamicResource OverlayBackgroundBrush}"
        Foreground="{DynamicResource OverlayTextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter
        x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Menu główne -->
        <Menu DockPanel.Dock="Top"
              Background="{x:Static services:AppColors.Ui252525Brush}"
              Foreground="{x:Static services:AppColors.UiWhiteBrush}">

            <Menu.Resources>
                <Style TargetType="{x:Type MenuItem}">
                    <Setter Property="Foreground" Value="{x:Static services:AppColors.UiBlackBrush}"/>
                </Style>
            </Menu.Resources>

            <MenuItem Header="{Binding Source={StaticResource Loc}, Path=[MenuWindow]}" Foreground="{x:Static services:AppColors.UiWhiteBrush}">
                <MenuItem x:Name="OverlayTopmostMenuItem"
                          Header="{Binding Source={StaticResource Loc}, Path=[MenuAlwaysOnTop]}"
                          IsCheckable="True"
                          Click="OverlayTopmostMenuItem_Click"/>

                <MenuItem x:Name="LockOverlaySizeMenuItem"
                          Header="{Binding Source={StaticResource Loc}, Path=[MenuLockOverlaySize]}"
                          IsCheckable="True"
                          Click="LockOverlaySizeMenuItem_Click"/>

                <MenuItem x:Name="ShowOverlayMenuItem"
                          Header="{Binding Source={StaticResource Loc}, Path=[MenuShowObsOverlay]}"
                          IsCheckable="True"
                          IsChecked="True"
                          Click="ShowOverlayMenuItem_Click"/>
            </MenuItem>

            <MenuItem Header="{Binding Source={StaticResource Loc}, Path=[MenuMode]}" Foreground="{x:Static services:AppColors.UiWhiteBrush}">
                <MenuItem x:Name="DisplayTestMenuItem"
                          Header="{Binding Source={StaticResource Loc}, Path=[MenuDisplayTest]}"
                          IsCheckable="True"
                          Click="DisplayTestMenuItem_Click"/>

                <MenuItem x:Name="SimulationMenuItem"
                          Header="{Binding Source={StaticResource Loc}, Path=[MenuSimulation]}"
                          IsCheckable="True"
                          Click="SimulationMenuItem_Click"/>
            </MenuItem>

            <MenuItem Header="{Binding Source={StaticResource Loc}, Path=[MenuOptions]}"
                      Foreground="{x:Static services:AppColors.UiWhiteBrush}">
                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=[MenuResetSettings]}"
                          Click="ResetSettings_Click"/>

                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=[MenuOpenCsvFolder]}"
                          Click="OpenCsvFolder_Click"/>

                <Separator/>

                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=[MenuSettings]}"
                          Click="SettingsMenuItem_Click"/>
            </MenuItem>

            <MenuItem Header="{Binding Source={StaticResource Loc}, Path=[MenuUpdate]}" Foreground="{x:Static services:AppColors.UiWhiteBrush}" Click="UpdateMenuItem_Click"/>

            <MenuItem Header="{Binding Source={StaticResource Loc}, Path=[MenuHelp]}" Foreground="{x:Static services:AppColors.UiWhiteBrush}">
                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=[MenuAbout]}" Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>


        <!-- Pasek stanu: połączenie, wskaźniki i nazwa miernika -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{x:Static services:AppColors.Ui252525Brush}"
                   Foreground="{x:Static services:AppColors.UiDDDDDDBrush}"
                   Padding="8,3">
            <StatusBar.Resources>
                <Style x:Key="IndicatorStyle" TargetType="Border">
                    <Setter Property="Width" Value="58"/>
                    <Setter Property="Height" Value="24"/>
                    <Setter Property="Margin" Value="3,0"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="BorderBrush" Value="{x:Static services:AppColors.Ui444444Brush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Background" Value="{x:Static services:AppColors.Ui202020Brush}"/>
                </Style>
            </StatusBar.Resources>

            <StatusBarItem>
                <TextBlock Text="{Binding Status}" MinWidth="210" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource OverlayDisconnectedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
                                    <Setter Property="Foreground" Value="{DynamicResource OverlayConnectedBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="Waiting">
                                    <Setter Property="Foreground" Value="{DynamicResource OverlayWaitingBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IndicatorStyle}">
                        <TextBlock Text="AUTO" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{x:Static services:AppColors.Ui333333Brush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoRange}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource OverlayRangeTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource IndicatorStyle}">
                        <TextBlock Text="MIN" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{x:Static services:AppColors.Ui333333Brush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMin}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource OverlayMinMaxBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource IndicatorStyle}">
                        <TextBlock Text="MAX" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{x:Static services:AppColors.Ui333333Brush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMax}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource OverlayMinMaxBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <TextBlock x:Name="UpdateNotification" Text="⬇ Dostępna aktualizacja" Foreground="#F2C14E"
                           Cursor="Hand" Visibility="Collapsed" MouseLeftButtonUp="UpdateNotification_Click"/>
            </StatusBarItem>

            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="DeviceNameText"
                           Text="{Binding DeviceName}"
                           Foreground="{x:Static services:AppColors.UiAAAAAABrush}"
                           FontSize="12"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Funkcja pomiarowa nad wyświetlaczem -->
        <Grid Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="5"
                    BorderBrush="{x:Static services:AppColors.Ui27618ABrush}"
                    BorderThickness="1"
                    Background="{x:Static services:AppColors.Ui10304ABrush}"
                    Padding="10,7">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="FunctionText"
                               Text="{Binding Function}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource OverlayTextBrush}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="128"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Stałe kolumny: wartość nie przesuwa się przy zmianie jednostki -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAcDcMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="105"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ValueText"
                                   Grid.Column="0"
                                   Text="{Binding DisplayValue}"
                                   FontSize="66"
                                   FontWeight="SemiBold"
                                   FontFamily="Consolas"
                                   Foreground="{DynamicResource OverlayTextBrush}"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap" Padding="0,0,25,0"/>

                        <Border Grid.Column="1"
                                Background="{x:Static services:AppColors.Ui444444Brush}"
                                Height="85"
                                VerticalAlignment="Center"
                                Margin="0"/>

                        <!-- Symbol diody nad jednostką, tylko dla funkcji 0x08 -->
                        <Grid Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Viewbox Grid.Row="0" Width="44" Height="22"
                                     HorizontalAlignment="Center" Stretch="Uniform">
                                <Path Data="M 2,11 L 12,11 M 12,2 L 12,20 L 31,11 Z M 31,2 L 31,20 M 31,11 L 42,11"
                                      Stroke="{DynamicResource OverlayTextBrush}"
                                      StrokeThickness="2.5"
                                      StrokeLineJoin="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDiodeMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Viewbox>
                            <TextBlock x:Name="UnitText"
                                       Grid.Row="1"
                                       Text="{Binding Unit}"
                                       Foreground="{DynamicResource OverlayTextBrush}"
                                       FontSize="30"
                                       TextWrapping="NoWrap"
                                       Padding="5"
                                       TextAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <!-- Dwa pomiary AC+DC -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAcDcMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding AcDisplayValue}" FontFamily="Consolas"
                                       FontSize="43" Foreground="{DynamicResource OverlayTextBrush}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="1" Text="~" Foreground="{DynamicResource OverlayAcBrush}"
                                       FontSize="30" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding AcDcUnit}" FontSize="22"
                                       Foreground="{DynamicResource OverlayTextBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DcDisplayValue}" FontFamily="Consolas"
                                       FontSize="43" Foreground="{DynamicResource OverlayTextBrush}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="1" Text="⎓" Foreground="{DynamicResource OverlayDcBrush}"
                                       FontSize="30" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding AcDcUnit}" FontSize="22"
                                       Foreground="{DynamicResource OverlayTextBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Rejestracja i licznik ramek po prawej -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Border BorderBrush="{x:Static services:AppColors.Ui555555Brush}" BorderThickness="1" CornerRadius="5"
                            Background="{x:Static services:AppColors.Ui202020Brush}" Padding="8,7" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="F12 · REC" HorizontalAlignment="Center"
                                       Foreground="{x:Static services:AppColors.Ui888888Brush}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock x:Name="RecordingIndicator"
                                       Text="{Binding RecordingStatus}"
                                       FontWeight="Bold" FontSize="17"
                                       Foreground="{x:Static services:AppColors.Ui999999Brush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="{x:Static services:AppColors.Ui555555Brush}" BorderThickness="1" CornerRadius="5"
                            Background="{x:Static services:AppColors.Ui202020Brush}" Padding="8,7">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[StatusFrames]}"
                                       Foreground="{x:Static services:AppColors.UiAAAAAABrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding RecordedFrames}"
                                       FontSize="21" FontWeight="SemiBold"
                                       Foreground="{x:Static services:AppColors.UiWhiteBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="{x:Static services:AppColors.Ui555555Brush}" BorderThickness="1" CornerRadius="5"
                            Background="{x:Static services:AppColors.Ui202020Brush}" Padding="8,7" Margin="0,10,0,0">
                        <TextBlock Text="HOLD" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{x:Static services:AppColors.Ui666666Brush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHold}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource OverlayHoldBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>